# Settings for docker-compose.yml. Copy to .env and edit:  cp .env.example .env

# Sign-in name and password (at least 12 characters). There is no default
# password: the container does not start without one.
AUGUSTUS_USER=caesar
AUGUSTUS_PASSWORD=

# Where the game files come from:
#   server - from AUGUSTUS_GAME_PATH on this host; browsers import them after sign-in
#   local  - every browser picks its own Caesar III folder
AUGUSTUS_GAME_SOURCE=server

# Your Caesar III folder on the host (the one with c3.sg2, c3.eng).
# Only read with AUGUSTUS_GAME_SOURCE=server.
AUGUSTUS_GAME_PATH=./game

# Where the saves, their older versions and the session secret are kept.
# Without it they go to the Docker volume augustus-data. Set a folder on the
# host (a path with a slash) to have them there as files, the saves in its
# saves/ subfolder; the folder has to be writable for user 1000.
#AUGUSTUS_DATA_PATH=/path/to/augustus-data

# Port on the host: http://<host-ip>:8080
AUGUSTUS_HTTP_PORT=8080

# How many days a sign-in lasts
AUGUSTUS_SESSION_DAYS=30

# 1 when a reverse proxy is in front of the port, 0 when browsers reach it directly
AUGUSTUS_TRUST_PROXY=0
