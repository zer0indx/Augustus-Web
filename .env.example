# Settings for docker-compose.yml. Copy to .env and edit:  cp .env.example .env

# Where the game files come from: server | upload
#   server - from GAME_DATA_PATH on this host; browsers import them after sign-in
#   upload - every player picks their own Caesar III folder or zip in the browser
GAME_DATA_MODE=server

# Your Caesar III folder on the host (the one with c3.sg2, c3.eng).
# Only read with GAME_DATA_MODE=server.
GAME_DATA_PATH=/volume1/games/Caesar3

# Folder for saves on the host (shared by every device you sign in from)
SAVES_PATH=/volume1/docker/augustus/saves

# Port on the host: http://<host-ip>:8080
AUGUSTUS_PORT=8080

# Sign-in. Setting a password turns the sign-in page on.
# Only AUTH_PASSWORD set: asks for the password alone.
# AUTH_USER and AUTH_PASSWORD set: asks for the user name and the password.
AUTH_USER=caesar
AUTH_PASSWORD=change-me
