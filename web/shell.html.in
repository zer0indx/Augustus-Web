<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#123b5d">
  <title>Augustus Web</title>
  <link rel="icon" type="image/png" href="augustus_256.png">
  <link rel="stylesheet" href="launcher.css">
</head>
<body>
<div id="setup">
  <div class="title">
    <h1>Augustus Web</h1>
    <p class="sub">Caesar III</p>
  </div>

  <div class="menu">
    <button class="menu-btn play" id="playBtn" disabled>Play</button>

    <!-- Shown when files are not imported -->
    <button class="menu-btn" id="serverBtn" hidden>Import Game Files</button>
    <button class="menu-btn" id="pickFolderBtn" hidden>Choose Game Folder</button>
    <button class="menu-btn" id="pickZipBtn" hidden>Import From Zip</button>
    <input type="file" id="folderInput" webkitdirectory directory multiple hidden>
    <input type="file" id="zipInput" accept=".zip,application/zip" hidden>

    <!-- Shown when files are imported -->
    <div class="menu-group" id="savesCard" hidden>
      <button class="menu-btn" id="downloadSavesBtn">Download Saves</button>
      <button class="menu-btn" id="uploadSavesBtn">Upload Saves</button>
      <input type="file" id="savesInput" accept=".zip,application/zip" hidden>
    </div>
  </div>

  <div class="panel">
    <h2 id="status">Loading engine…</h2>

    <div id="progressCard" class="inset" hidden>
      <div class="bar"><div id="progress"></div></div>
      <div id="progressText">0%</div>
    </div>

    <div class="inset" id="infoCard">
      <p id="sourceHelp">The game files come from this server. Importing copies them into this browser's storage; it is needed once per browser.</p>
      <p>Saves are kept on this server and follow you to every browser you sign in from.</p>
      <div id="syncText"></div>
    </div>

    <div class="footer">
      <button class="menu-btn small" id="clearBtn" hidden>Remove Game Files From Browser</button>
      <button class="menu-btn small" id="logoutBtn" hidden>Sign Out</button>
    </div>
  </div>
</div>

<div id="game">
  <canvas id="canvas" tabindex="-1"></canvas>
  <div id="busy" hidden><div class="spinner"></div>Loading…</div>
  <div id="toast" hidden></div>
</div>

<script src="jszip.min.js"></script>
<script src="launcher.js"></script>
{{{ SCRIPT }}}
</body>
</html>
